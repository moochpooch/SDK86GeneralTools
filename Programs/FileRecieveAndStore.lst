     1                                  ORG 0100h
     2                                  CPU 8086
     3                                  BITS 16
     4                                  
     5                                  ; The goal of the program is to accept a specific byte sequence from serial, then take a command, an address, and write a file in 64 byte sequences to the specified location with checksums every internval.
     6                                  
     7                                  ; No fallback or timeout during CONSUME_AND_STORE
     8                                  TEST:
     9 00000000 B80004                  	mov ax, 0400h
    10 00000003 50                      	push ax
    11 00000004 E80500                  	call MAIN
    12 00000007 83C402                  	add sp, 2
    13 0000000A CD02                    	int 2
    14                                  
    15                                  MAIN:				; One argument, SI, push to stack before call
    16                                  .INIT:
    17 0000000C 55                      	push bp
    18 0000000D 89E5                    	mov bp, sp		; Use BP as the ref for local variables
    19 0000000F 83EC02                  	sub sp, 2		; allocate 1 word variable
    20                                  
    21 00000012 C746FE0000              	mov word [bp - 2], 0	; temp = 0
    22                                  
    23 00000017 50                      	push ax			; Push used regs
    24                                  
    25 00000018 8B7604                  	mov si, [bp + 4]	; Load SI argument
    26 0000001B 31C0                    	xor ax, ax		; Clear AX
    27                                  
    28                                  .RECIEVE_TRANSMIT_SIGNAL:
    29 0000001D 8D46FE                  	lea ax, [bp - 2]        ; Low byte of local word
    30 00000020 50                      	push ax                	; Persistent pointer
    31                                  	
    32 00000021 E83C00                  	call CONSUME_BYTE      	; Receive low byte for temp, [lo][hi]
    33                                  	
    34 00000024 FF46FA                  	inc word [bp - 6]      	; Advance pointer to high byte
    35                                  	
    36 00000027 E83600                  	call CONSUME_BYTE      	; Receive high byte for temp, [lo][hi]
    37                                  	
    38 0000002A 83C402                  	add sp, 2              	; Remove pointer
    39                                  	
    40 0000002D 817EFE8680              	cmp word [bp-2], 8086h	; Signature for recieve, sender must send in little endian, 86h, then 80h
    41 00000032 75E9                    	jne .RECIEVE_TRANSMIT_SIGNAL
    42                                  	
    43 00000034 EB00                    	jmp .INTERPRET_COMMAND
    44                                  
    45                                  .INTERPRET_COMMAND:		; For now just one command, but command logic would go here, likely using a table
    46 00000036 56                      	push si			; Push destination address adrgument passed to main to argument for FILE_RECV
    47 00000037 E80B00                  	call FILE_RECV
    48 0000003A 83C402                  	add sp, 2		; Remove reference location made before FILE_RECV call
    49                                  	
    50 0000003D EB00                    	jmp .END
    51                                  
    52                                  .END:
    53 0000003F 58                      	pop ax
    54                                  
    55 00000040 83C402                  	add sp, 2		; Clear temp
    56 00000043 5D                      	pop bp
    57                                  
    58 00000044 C3                      	ret
    59                                  
    60                                  FILE_RECV:
    61 00000045 55                      	push bp
    62 00000046 89E5                    	mov bp, sp
    63 00000048 50                      	push ax
    64 00000049 51                      	push cx
    65                                  
    66 0000004A B94000                  	mov cx, 64
    67 0000004D 8B4604                  	mov ax, [bp + 4]
    68 00000050 50                      	push ax
    69                                  .CONSUME_LOOP:
    70 00000051 E80C00                  	call CONSUME_BYTE
    71 00000054 FF46FA                  	inc word [bp - 6]
    72 00000057 E2F8                    	loop .CONSUME_LOOP
    73                                  
    74 00000059 83C402                  	add sp, 2
    75 0000005C 59                      	pop cx
    76 0000005D 58                      	pop ax
    77 0000005E 5D                      	pop bp
    78 0000005F C3                      	ret
    79                                  
    80                                  
    81                                  CONSUME_BYTE:			; Takes an argument to store one byte
    82 00000060 55                      	push bp
    83 00000061 89E5                    	mov bp, sp
    84 00000063 52                      	push dx
    85 00000064 56                      	push si
    86                                  
    87 00000065 BAF2FF                  	mov dx, 0xFFF2
    88                                  
    89                                  .CONSUME_BYTE_LOOP:		; Standby loop; waits until UART signals that a byte is ready
    90 00000068 EC                      	in al, dx
    91 00000069 A802                    	test al, 0x02
    92 0000006B 74FB                    	jz .CONSUME_BYTE_LOOP
    93                                  
    94                                  .WRITE_BYTE:			; Write word to SI locations
    95 0000006D BAF0FF                  	mov dx, 0xFFF0		; UART read/write location
    96 00000070 EC                      	in al, dx
    97                                  
    98 00000071 8B7604                  	mov si, [bp + 4]	; Deref the address and move to that location
    99 00000074 368804                  	mov [ss:si], al
   100                                  	
   101 00000077 5E                      	pop si
   102 00000078 5A                      	pop dx
   103 00000079 5D                      	pop bp
   104 0000007A C3                      	ret			; RET to caller
   105                                  
   106                                  
   107                                  
