     1                                  org 0100h
     2                                  bits 16
     3                                  
     4                                  test:
     5 00000000 E80200                      call write_start
     6 00000003 CD02                        int 2
     7                                  
     8                                  write_start:
     9 00000005 50                          push ax
    10 00000006 53                          push bx
    11 00000007 51                          push cx
    12 00000008 52                          push dx
    13 00000009 56                          push si
    14                                  
    15                                      ; 8279 command port
    16 0000000A BAEAFF                      mov dx, 0FFEAh
    17                                  
    18                                      ; Save current ax
    19 0000000D 50                          push ax
    20                                      ; Clear display command
    21 0000000E B0D1                        mov al, 11010001b
    22 00000010 EE                          out dx, al
    23                                  
    24 00000011 E82200                      call delay
    25                                  
    26                                      ; Write display RAM, auto-increment
    27 00000014 B090                        mov al, 10010000b
    28 00000016 EE                          out dx, al
    29                                  
    30 00000017 BB0A00                      mov bx, 10
    31                                      
    32                                      ; Recall original ax
    33 0000001A 58                          pop ax
    34                                  .loop_start:
    35 0000001B 31D2                        xor dx, dx
    36 0000001D F7F3                        div bx                  ; AX = quotient, DX = remainder   
    37                                  
    38 0000001F 89D6                        mov si, dx              ; save digit before restoring port
    39                                  
    40                                      ; Preserve quotient because loading AL would modify AX
    41 00000021 50                          push ax
    42                                  
    43 00000022 2E8A84[3C00]                mov al, [cs:lookup_table + si]
    44                                  
    45 00000027 BAE8FF                      mov dx, 0FFE8h
    46 0000002A EE                          out dx, al
    47                                  
    48 0000002B 58                          pop ax                  ; restore quotient
    49                                  
    50 0000002C 85C0                        test ax, ax
    51 0000002E 75EB                        jnz .loop_start
    52                                  
    53                                  .exit_routine:
    54 00000030 5E                          pop si
    55 00000031 5A                          pop dx
    56 00000032 59                          pop cx
    57 00000033 5B                          pop bx
    58 00000034 58                          pop ax
    59 00000035 C3                          ret
