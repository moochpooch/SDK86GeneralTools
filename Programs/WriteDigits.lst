    68 0000003C 3F                          db 3Fh                  ; 0
    69 0000003D 06                          db 06h                  ; 1
    70 0000003E 5B                          db 5Bh                  ; 2
    71 0000003F 4F                          db 4Fh                  ; 3
    72 00000040 66                          db 66h                  ; 4
    73 00000041 6D                          db 6Dh                  ; 5
    74 00000042 7D                          db 7Dh                  ; 6
