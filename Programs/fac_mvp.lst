   207                                  ; === Original routines, with minimal assembly/test fixes ===
   208                                  ; ----- MATRIX_ADDR -----
   209                                  MATRIX_ADDR:
   210 000001A2 30E4                        xor ah, ah      ; Clear ah, now AX = row
   211 000001A4 30FF                        xor bh, bh      ; clear bh, now BX = col
   212                                      
   213 000001A6 89C2                        mov dx, ax      ; set dx 
   214 000001A8 D1E0                        shl ax, 1       ; 2*r
   215 000001AA 01D0                        add ax, dx      ; 3*r
   216 000001AC D1E0                        shl ax, 1        ; 6*r
   217                                  
   218 000001AE D1E3                        shl bx, 1       ; 2*c
   219 000001B0 01D8                        add ax, bx      ; final address for given element
   220                                  
   221 000001B2 BE[7201]                    mov si, MATRIX  ; move pointer to start of matrix
   222 000001B5 01C6                        add si, ax      ; add offset to that pointer to get element address.
   223                                      
   224 000001B7 C3                          ret             ; Job is done after this
   225                                  
   226                                  ; ----- FAC_LOAD -----
   227                                  FAC_LOAD:
   228 000001B8 8B04                        mov ax, [si]        ; Use AX as the point to extract from using bx
   229                                  
   230                                  .extract_sign:
   231 000001BA 88E3                        mov bl, ah
   232 000001BC D0EB                        shr bl, 1           ; extract the high byte of ah, then shift 7 to isolate sign bit
   233 000001BE D0EB                        shr bl, 1 
   234 000001C0 D0EB                        shr bl, 1 
   235 000001C2 D0EB                        shr bl, 1 
   236 000001C4 D0EB                        shr bl, 1 
   237 000001C6 D0EB                        shr bl, 1 
   238 000001C8 D0EB                        shr bl, 1           ; 8086 doesn't support shifts beyond just one at a time
   239                                  
   240 000001CA 881E[8601]                  mov [FAC_SIGN], bl  ; Store the sign bit into FAC_SIGN
   241                                  
   242                                  .extract_magnitude:
   243 000001CE 89C3                        mov bx, ax
   244 000001D0 81E3F07F                    and bx, 7FF0h               ; Clear low 4 bits and high 1 bit
   245 000001D4 D1EB                        shr bx, 1                   ; Shift by 4 to allign mag to lower bits
   246 000001D6 D1EB                        shr bx, 1 
   247 000001D8 D1EB                        shr bx, 1 
   248 000001DA D1EB                        shr bx, 1
   249                                  
   250 000001DC 891E[8801]                  mov [FAC_MAG_LO], bx        ; Store the unpacked mag into the FAC low memory
   251 000001E0 C706[8A01]0000              mov word [FAC_MAG_HI], 0    ; Clear the high memory space
   252                                  
   253                                  .extract_exponent:
   254 000001E6 88C3                        mov bl, al                  ; Move the exponent into b low
   255 000001E8 80E30F                      and bl, 0Fh                 ; Clear high nibble, keep low since we only need the low 4 bits
   256                                      
   257 000001EB D0E3                        shl bl, 1                   ; Align the cleared 4 bit to the left of the 8 bit reg
   258 000001ED D0E3                        shl bl, 1
   259 000001EF D0E3                        shl bl, 1
   260 000001F1 D0E3                        shl bl, 1
   261                                  
   262 000001F3 D0FB                        sar bl, 1                   ; Shift the exponent to the right but while preserving the sign
   263 000001F5 D0FB                        sar bl, 1
   264 000001F7 D0FB                        sar bl, 1
   265 000001F9 D0FB                        sar bl, 1
   266                                  
   267 000001FB 881E[8701]                  mov [FAC_EXP], bl
   268                                      
   269 000001FF C3                          ret
   270                                  
   271                                  ; ----- FTMP_LOAD -----
   272                                  FTMP_LOAD:
   273 00000200 8B04                        mov ax, [si]        ; Use AX as the point to extract from using bx
   274                                  
   275                                  .extract_sign:
   276 00000202 88E3                        mov bl, ah
   277 00000204 D0EB                        shr bl, 1           ; extract the high byte of ah, then shift 7 to isolate sign bit
   278 00000206 D0EB                        shr bl, 1 
   279 00000208 D0EB                        shr bl, 1 
   280 0000020A D0EB                        shr bl, 1 
   281 0000020C D0EB                        shr bl, 1 
   282 0000020E D0EB                        shr bl, 1 
   283 00000210 D0EB                        shr bl, 1           ; 8086 doesn't support shifts beyond just one at a time
   284                                  
   285 00000212 881E[8C01]                  mov [FTMP_SIGN], bl  ; Store the sign bit into FAC_SIGN
   286                                  
   287                                  .extract_magnitude:
