     1                                  ORG 100h
     2                                  BITS 16
     3                                  
     4                                  ; Intel SDK-86 FAC arithmetic MVP test harness (8086 / NASM)
     5                                  ; Assemble: nasm -f bin fac_mvp_sdk86.asm -o fac_mvp_sdk86.bin
     6                                  ; Transfer binary to 0000:0100 (ORG 100h), then GO 0000:0100.
     7                                  ; On completion calls INT 2 to return to the SDK-86 monitor.
     8                                  ; The test results are stored at fixed offsets for easy monitor inspection:
     9                                  ;   0000:0102 - 0000:010A TEST_RESULTS[0..8] (01=pass, FF=fail, 00=not run)
    10                                  ;   0000:010B FAILURES (number of failed tests)
    11                                  ;   0000:010C - 0000:010D TEST_OUT (last packed test result, little endian)
    12                                  ;   0000:010E TEST_DONE (01=finished, 00=not finished)
    13                                  ;
    14                                  ; Uses current monitor-provided SS:SP; do not run if stack is not valid.
    15                                  ; INT 2 behavior is user-confirmed SDK-86 monitor behavior.
    16                                  ;
    17                                  start:
    18 00000000 EB0D                        jmp short main
    19                                  
    20 00000002 00<rep 9h>              TEST_RESULTS: times 9 db 0
    21 0000000B 00                      FAILURES: db 0
    22 0000000C 0000                    TEST_OUT: dw 0
    23 0000000E 00                      TEST_DONE: db 0
    24                                  
    25                                  main:
    26 0000000F 0E                          push cs
    27 00000010 1F                          pop ds
    28                                      ; Clear prior results so rerunning doesn't leave stale test marks.
    29 00000011 C606[0E00]00                mov byte [TEST_DONE], 0
    30 00000016 C606[0B00]00                mov byte [FAILURES], 0
    31 0000001B BF[0200]                    mov di, TEST_RESULTS
    32 0000001E B90900                      mov cx, 9
    33                                  .clear:
    34 00000021 C60500                      mov byte [di], 0
    35 00000024 47                          inc di
    36 00000025 E2FA                        loop .clear
    37                                  
    38                                      ; TEST 0: load 2, add 3 => packed 5
    39 00000027 BE[7201]                    mov si, MATRIX+0
    40 0000002A E88B01                      call FAC_LOAD
    41 0000002D BE[7401]                    mov si, MATRIX+2
    42 00000030 E8F602                      call FP_ADD
    43 00000033 BE[0C00]                    mov si, TEST_OUT
    44 00000036 E80F02                      call FAC_STORE
    45 00000039 B85000                      mov ax, 0050h
    46 0000003C BB0000                      mov bx, 0
    47 0000003F E81701                      call CHECK_PACKED
    48                                  
    49                                      ; TEST 1: load 7, subtract 3 => packed 4
    50 00000042 BE[7801]                    mov si, MATRIX+6
    51 00000045 E87001                      call FAC_LOAD
    52 00000048 BE[7401]                    mov si, MATRIX+2
    53 0000004B E8F802                      call FAC_SUB
    54 0000004E BE[0C00]                    mov si, TEST_OUT
    55 00000051 E8F401                      call FAC_STORE
    56 00000054 B84000                      mov ax, 0040h
    57 00000057 BB0100                      mov bx, 1
    58 0000005A E8FC00                      call CHECK_PACKED
    59                                  
    60                                      ; TEST 2: load 7, multiply 11 => packed 77
    61 0000005D BE[7801]                    mov si, MATRIX+6
    62 00000060 E85501                      call FAC_LOAD
    63 00000063 BE[7A01]                    mov si, MATRIX+8
    64 00000066 E8FA02                      call FAC_MUL
    65 00000069 BE[0C00]                    mov si, TEST_OUT
    66 0000006C E8D901                      call FAC_STORE
    67 0000006F B8D004                      mov ax, 04D0h
    68 00000072 BB0200                      mov bx, 2
    69 00000075 E8E100                      call CHECK_PACKED
    70                                  
    71                                      ; TEST 3: -3 * 2 => -6
    72 00000078 BE[7E01]                    mov si, NEG_THREE
    73 0000007B E83A01                      call FAC_LOAD
    74 0000007E BE[7201]                    mov si, MATRIX+0
    75 00000081 E8DF02                      call FAC_MUL
    76 00000084 BE[0C00]                    mov si, TEST_OUT
    77 00000087 E8BE01                      call FAC_STORE
    78 0000008A B86080                      mov ax, 8060h
    79 0000008D BB0300                      mov bx, 3
    80 00000090 E8C600                      call CHECK_PACKED
    81                                  
    82                                      ; TEST 4: exponent alignment: 2 + (3*2^1) = 8
    83 00000093 BE[7201]                    mov si, MATRIX+0
    84 00000096 E81F01                      call FAC_LOAD
    85 00000099 BE[8001]                    mov si, THREE_EXP_ONE
    86 0000009C E88A02                      call FP_ADD
    87 0000009F BE[0C00]                    mov si, TEST_OUT
    88 000000A2 E8A301                      call FAC_STORE
    89 000000A5 B84100                      mov ax, 0041h     ; 4*2^1 = 8, after alignment/truncation
    90 000000A8 BB0400                      mov bx, 4
    91 000000AB E8AB00                      call CHECK_PACKED
    92                                  
    93                                      ; TEST 5: zero * negative => canonical zero
    94 000000AE BE[8201]                    mov si, ZERO_VALUE
    95 000000B1 E80401                      call FAC_LOAD
    96 000000B4 BE[7E01]                    mov si, NEG_THREE
    97 000000B7 E8A902                      call FAC_MUL
    98 000000BA BE[0C00]                    mov si, TEST_OUT
    99 000000BD E88801                      call FAC_STORE
   100 000000C0 B80000                      mov ax, 0000h
   101 000000C3 BB0500                      mov bx, 5
   102 000000C6 E89000                      call CHECK_PACKED
   103                                  
   104                                      ; TEST 6: 2047^3 needs 64 -> 32-bit normalization
   105                                      ; 2047^3 = 0x1FF4017FF, so FAC magnitude = 0xFFA00BFF, E=1
   106 000000C9 BE[8401]                    mov si, MAX_MANTISSA
   107 000000CC E8E900                      call FAC_LOAD
   108 000000CF BE[8401]                    mov si, MAX_MANTISSA
   109 000000D2 E88E02                      call FAC_MUL
   110 000000D5 BE[8401]                    mov si, MAX_MANTISSA
   111 000000D8 E88802                      call FAC_MUL
   112 000000DB BB0600                      mov bx, 6
   113 000000DE 813E[8801]FF0B              cmp word [FAC_MAG_LO], 0BFFh
   114 000000E4 7513                        jne .chain_failed
   115 000000E6 833E[8A01]A0                cmp word [FAC_MAG_HI], 0FFA0h
   116 000000EB 750C                        jne .chain_failed
   117 000000ED 803E[8701]01                cmp byte [FAC_EXP], 1
   118 000000F2 7505                        jne .chain_failed
   119 000000F4 E86A00                      call MARK_PASS
   120 000000F7 EB03                        jmp .chain_done
   121                                  .chain_failed:
   122 000000F9 E86B00                      call MARK_FAIL
   123                                  .chain_done:
   124                                  
   125                                      ; TEST 7: FAC_STORE does not mutate the FAC source
   126                                      ; 2047^2 = 0x003FF001, exponent=0
   127 000000FC BE[8401]                    mov si, MAX_MANTISSA
   128 000000FF E8B600                      call FAC_LOAD
   129 00000102 BE[8401]                    mov si, MAX_MANTISSA
   130 00000105 E85B02                      call FAC_MUL
   131 00000108 BE[0C00]                    mov si, TEST_OUT
   132 0000010B E83A01                      call FAC_STORE
   133 0000010E BB0700                      mov bx, 7
   134 00000111 813E[8801]01F0              cmp word [FAC_MAG_LO], 0F001h
   135 00000117 7513                        jne .preserve_failed
   136 00000119 833E[8A01]3F                cmp word [FAC_MAG_HI], 003Fh
   137 0000011E 750C                        jne .preserve_failed
   138 00000120 803E[8701]00                cmp byte [FAC_EXP], 0
   139 00000125 7505                        jne .preserve_failed
   140 00000127 E83700                      call MARK_PASS
   141 0000012A EB03                        jmp .preserve_done
   142                                  .preserve_failed:
   143 0000012C E83800                      call MARK_FAIL
   144                                  .preserve_done:
   145                                  
   146                                      ; TEST 8: FAC_SAVE / FAC_RES restore loaded 7
   147 0000012F BE[7801]                    mov si, MATRIX+6
   148 00000132 E88300                      call FAC_LOAD
   149 00000135 E8DE02                      call FAC_SAVE
   150 00000138 BE[7201]                    mov si, MATRIX+0
   151 0000013B E87A00                      call FAC_LOAD
   152 0000013E E8F202                      call FAC_RES
   153 00000141 BE[0C00]                    mov si, TEST_OUT
   154 00000144 E80101                      call FAC_STORE
   155 00000147 B87000                      mov ax, 0070h
   156 0000014A BB0800                      mov bx, 8
   157 0000014D E80900                      call CHECK_PACKED
   158                                  
   159 00000150 C606[0E00]01                mov byte [TEST_DONE], 1
   160 00000155 CD02                        int 2                ; SDK-86 monitor return (not DOS)
   161                                  .after_return:
   162 00000157 EBFE                        jmp .after_return    ; Defensive: if monitor unexpectedly returns
   163                                  
   164                                  ; AX expected packed value; BX = 0-based test index
   165                                  CHECK_PACKED:
   166 00000159 3B06[0C00]                  cmp ax, [TEST_OUT]
   167 0000015D 7508                        jne MARK_FAIL
   168 0000015F EB00                        jmp MARK_PASS
   169                                  
   170                                  MARK_PASS:
   171 00000161 C687[0200]01                mov byte [TEST_RESULTS+bx], 1
   172 00000166 C3                          ret
   173                                  
   174                                  MARK_FAIL:
   175 00000167 C687[0200]FF                mov byte [TEST_RESULTS+bx], 0FFh
   176 0000016C FE06[0B00]                  inc byte [FAILURES]
   177 00000170 C3                          ret
   178                                  
   179                                  ; 2x3 augmented matrix, row-major; S11E4 packed M*2^E
   180                                  ; row0: [2, 3 | 5]; row1: [7, 11 | 13]
   181 00000171 02                      N: db 2
   182 00000172 2000300050007000B0-     MATRIX: dw 0020h,0030h,0050h,0070h,00B0h,00D0h
   182 0000017B 00D000             
   183 0000017E 3080                    NEG_THREE: dw 8030h
   184 00000180 3100                    THREE_EXP_ONE: dw 0031h
   185 00000182 0000                    ZERO_VALUE: dw 0000h
   186 00000184 F07F                    MAX_MANTISSA: dw 7FF0h
   187                                  
   188                                  ; Floating-point registers and multiplication scratch
   189 00000186 00                      FAC_SIGN: db 0
   190 00000187 00                      FAC_EXP: db 0
   191 00000188 0000                    FAC_MAG_LO: dw 0
   192 0000018A 0000                    FAC_MAG_HI: dw 0
   193 0000018C 00                      FTMP_SIGN: db 0
   194 0000018D 00                      FTMP_EXP: db 0
   195 0000018E 0000                    FTMP_MAG_LO: dw 0
   196 00000190 0000                    FTMP_MAG_HI: dw 0
   197 00000192 00                      FSRC_SIGN: db 0
   198 00000193 00                      FSRC_EXP: db 0
   199 00000194 0000                    FSRC_MAG_LO: dw 0
   200 00000196 0000                    FSRC_MAG_HI: dw 0
   201 00000198 0000                    FMULTI: dw 0
   202 0000019A 0000                    FMUL_0: dw 0
   203 0000019C 0000                    FMUL_1: dw 0
   204 0000019E 0000                    FMUL_2: dw 0
   205 000001A0 0000                    FMUL_3: dw 0
