   404                                  ; ----- EXP_ALIGN -----
   405                                  EXP_ALIGN:
   406                                  .find_smallest_exp:
   407 000002D1 A0[8701]                    mov al, [FAC_EXP]
   408 000002D4 3A06[8D01]                  cmp al, [FTMP_EXP]
   409                                  
   410 000002D8 7C29                        jl .shift_fac_exp           ; FAC exponent is smaller
   411 000002DA 7F02                        jg .shift_ftmp_exp          ; FTMP exponent is smalelr
   412 000002DC EB4A                        jmp .end                    ; already equal
   413                                  
   414                                  .shift_ftmp_exp:                ; Exponent shifting done on ftmp
   415 000002DE 8A1E[8701]                  mov bl, [FAC_EXP]           ; Load FAC_EXP into bl for optimization, pointless right now, but im new to this so chill
   416                                  
   417 000002E2 8B16[9001]                  mov dx, [FTMP_MAG_HI]
   418 000002E6 A1[8E01]                    mov ax, [FTMP_MAG_LO]
   419                                  
   420                                  .ftmp_loop:                     ; Loop to shift ftmp exponent
   421 000002E9 381E[8D01]                  cmp [FTMP_EXP], bl
   422 000002ED 740B                        je .ftmp_done
   423                                  
   424 000002EF 8006[8D01]01                add byte [FTMP_EXP], 1      ; Add one to increase the exponent
   425                                  
   426 000002F4 D1EA                        shr dx, 1                   ; Shift the magnitude to match the increase in exponent
   427 000002F6 D1D8                        rcr ax, 1
   428                                  
   429 000002F8 EBEF                        jmp .ftmp_loop
   430                                  
   431                                  .ftmp_done:                     ; Store magnitude values
   432 000002FA 8916[9001]                  mov [FTMP_MAG_HI], dx
   433 000002FE A3[8E01]                    mov [FTMP_MAG_LO], ax
   434                                      
   435 00000301 EB25                        jmp .end
   436                                  
