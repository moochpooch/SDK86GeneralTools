   463                                  ; ----- FP_ADD -----
   464                                  FP_ADD:
   465 00000329 E8D4FE                      call FTMP_LOAD              ; Load pointed to value into FTMP
   466 0000032C E8A2FF                      call EXP_ALIGN              ; Align exponents and adjust mags
   467                                  
   468                                  .addition:
   469 0000032F A1[8801]                    mov ax, [FAC_MAG_LO]        ; Load the regs with FAC
   470 00000332 8B16[8A01]                  mov dx, [FAC_MAG_HI]
   471                                      
   472 00000336 0306[8E01]                  add ax, [FTMP_MAG_LO]       ; Add low mags together
