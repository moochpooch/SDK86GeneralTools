   362                                  FTMP_STORE:
   363 0000028B A1[8E01]                    mov ax, [FTMP_MAG_LO]
   364 0000028E 8B16[9001]                  mov dx, [FTMP_MAG_HI]
   365                                      
   366 00000292 B91500                      mov cx, 21              ; loop 21 times to make the 32 bit memory into 11 bits
   367                                  .normalize:
   368 00000295 83FA00                      cmp dx, 0
   369 00000298 7505                        jne .shift
   370                                  
   371 0000029A 3DFF07                      cmp ax, 07FFh
   372 0000029D 760A                        jbe .normalized
   373                                  
   374                                  .shift:
   375 0000029F D1EA                        shr dx, 1
   376 000002A1 D1D8                        rcr ax, 1
   377 000002A3 FE06[8D01]                  inc byte [FTMP_EXP]
