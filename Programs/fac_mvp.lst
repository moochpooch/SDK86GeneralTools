   382 000002AB D1E0                        shl ax, 1
   383 000002AD D1E0                        shl ax, 1
   384 000002AF D1E0                        shl ax, 1
   385                                  
   386 000002B1 8A1E[8D01]                  mov bl, [FTMP_EXP]       ; load and clear lower 4 of exponent, then or with al
