   316                                  ; ----- FAC_STORE -----
   317                                  FAC_STORE:
   318 00000248 A1[8801]                    mov ax, [FAC_MAG_LO]
   319 0000024B 8B16[8A01]                  mov dx, [FAC_MAG_HI]
   320 0000024F 8A0E[8701]                  mov cl, [FAC_EXP]
   321                                  
   322                                  .normalize:
   323 00000253 83FA00                      cmp dx, 0
   324 00000256 7505                        jne .shift
   325                                  
   326 00000258 3DFF07                      cmp ax, 07FFh
   327 0000025B 7608                        jbe .normalized
   328                                  
   329                                  .shift:
   330 0000025D D1EA                        shr dx, 1
   331 0000025F D1D8                        rcr ax, 1
   332 00000261 FEC1                        inc cl
   333 00000263 EBEE                        jmp .normalize
   334                                  
   335                                  .normalized:
   336                                      ; Move mag into bits 4-14
   337 00000265 D1E0                        shl ax, 1
   338 00000267 D1E0                        shl ax, 1
   339 00000269 D1E0                        shl ax, 1
   340 0000026B D1E0                        shl ax, 1
   341                                  
   342                                      ; Exponent in bits 0-3
   343 0000026D 88CB                        mov bl, cl              ; use normalized exponent copy, not FAC_EXP
   344 0000026F 80E30F                      and bl, 0Fh
   345 00000272 08D8                        or al, bl
   346                                  
   347                                      ; Sign bit 15
   348 00000274 8A1E[8601]                  mov bl, [FAC_SIGN]     ; Load the sign byte into bl
   349 00000278 D0E3                        shl bl, 1              ; Shift left by 7 to get sign bit to left side of reg
   350 0000027A D0E3                        shl bl, 1
   351 0000027C D0E3                        shl bl, 1
   352 0000027E D0E3                        shl bl, 1
   353 00000280 D0E3                        shl bl, 1
   354 00000282 D0E3                        shl bl, 1
   355 00000284 D0E3                        shl bl, 1
   356 00000286 08DC                        or ah, bl             ; Join bl to ah    
   357                                  
   358 00000288 8904                        mov [si], ax
   359 0000028A C3                          ret
