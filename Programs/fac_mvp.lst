   391 000002BE D0E3                        shl bl, 1              ; Shift left by 7 to get sign bit to left side of reg
   392 000002C0 D0E3                        shl bl, 1
   393 000002C2 D0E3                        shl bl, 1
   394 000002C4 D0E3                        shl bl, 1
   395 000002C6 D0E3                        shl bl, 1
   396 000002C8 D0E3                        shl bl, 1
   397 000002CA D0E3                        shl bl, 1
