   300 00000230 80E30F                      and bl, 0Fh                 ; Clear high nibble, keep low since we only need the low 4 bits
   301                                      
   302 00000233 D0E3                        shl bl, 1                   ; Align the cleared 4 bit to the left of the 8 bit reg
