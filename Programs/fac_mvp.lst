   441 0000030B A1[8801]                    mov ax, [FAC_MAG_LO]
   442                                      
   443                                  .fac_loop:                      ; Loop to shift ftmp exponent
   444 0000030E 381E[8701]                  cmp [FAC_EXP], bl
   445 00000312 740B                        je .fac_done
   446                                  
   447 00000314 8006[8701]01                add byte [FAC_EXP], 1       ; Add one to increase the exponent
   448                                  
   449 00000319 D1EA                        shr dx, 1                   ; Shift the magnitude to match the increase in exponent
   450 0000031B D1D8                        rcr ax, 1
   451                                  
   452 0000031D EBEF                        jmp .fac_loop
   453                                  
   454                                  .fac_done:
   455 0000031F 8916[8A01]                  mov [FAC_MAG_HI], dx        ; Store magnitude values
   456 00000323 A3[8801]                    mov [FAC_MAG_LO], ax
   457                                  
   458 00000326 EB00                        jmp .end
   459                                  
   460                                  .end:
   461 00000328 C3                          ret
