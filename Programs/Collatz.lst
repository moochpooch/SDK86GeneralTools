     1                                  org 0100h
     2                                  
     3                                  bits 16
     4                                  start:
     5                                      ; Initial clear display.
     6 00000000 BAEAFF                  	mov dx, 0FFEAH
     7 00000003 B0D1                    	mov al, 11010001b
     8 00000005 EE                      	out dx, al
     9                                  
    10 00000006 0E                          push cs
    11 00000007 1F                          pop ds              ; make DS point at this code/data segment
    12                                  
    13 00000008 B9F401                      mov cx, 500         ; current Collatz value
    14 0000000B BE[9200]                    mov si, trace       ; SI points at next trace slot
    15 0000000E C706[9201]0000              mov word [steps], 0
    16 00000014 C706[9401]0000              mov word [status], 0
    17                                  
    18                                  main:
    19                                      ; Save the current value before changing it.
    20 0000001A 81FE[9201]                  cmp si, trace_end
    21 0000001E 735A                        jae trace_full
    22                                  
    23 00000020 890C                        mov [si], cx
    24 00000022 83C602                      add si, 2           ; each trace entry is a word
    25 00000025 FF06[9201]                  inc word [steps]
    26                                  
    27 00000029 83F901                      cmp cx, 1
    28 0000002C 7425                        je finished
    29                                  
    30                                      ; Divide CX by 2.
    31 0000002E 89C8                        mov ax, cx
    32 00000030 BB0200                      mov bx, 2
    33 00000033 31D2                        xor dx, dx
    34 00000035 F7F3                        div bx              ; AX = CX / 2, DX = CX % 2
    35                                  
    36 00000037 85D2                        test dx, dx
    37 00000039 7414                        jz even
    38                                  
    39                                      ; Odd: CX = 3 * CX + 1
    40 0000003B 89C8                        mov ax, cx
    41 0000003D BB0300                      mov bx, 3
    42 00000040 F7E3                        mul bx              ; DX:AX = CX * 3
    43                                  
    44 00000042 09D2                        or dx, dx
    45 00000044 753C                        jnz overflow        ; product did not fit in 16 bits
    46                                  
    47 00000046 83C001                      add ax, 1
    48 00000049 7237                        jc overflow         ; result wrapped from FFFFh to 0000h
    49                                  
    50 0000004B 89C1                        mov cx, ax
    51 0000004D EBCB                        jmp main
    52                                  
    53                                  even:
    54                                      ; AX already contains CX / 2.
    55 0000004F 89C1                        mov cx, ax
    56 00000051 EBC7                        jmp main
    57                                  
    58                                  finished:
    59                                  	; Clear display.
    60 00000053 BAEAFF                  	mov dx, 0FFEAH
    61 00000056 B0D1                    	mov al, 11010001b
    62 00000058 EE                      	out dx, al
    63                                  
    64                                  	; Wait for mandatory clear before writing into ram.
    65 00000059 E82E00                  	call delay
    66                                  
    67                                  	; Write display, auto increment enabled.
    68 0000005C B090                    	mov al, 10010000b
    69 0000005E EE                      	out dx, al
    70                                  
    71                                  	; Store the segment pattern for “E” at RAM address 0.
    72 0000005F BAE8FF                  	mov dx, 0FFE8H
    73 00000062 B87900                  	mov ax, 00079H
    74 00000065 EF                      	out dx, ax
    75                                  
    76                                  	; Store the segment pattern for "n",.
    77 00000066 B85400                  	mov ax, 00054h
    78 00000069 EF                      	out dx, ax
    79                                  
    80                                  	; Store the segment pattern for "O".
    81 0000006A B83F00                  	mov ax, 0003Fh
    82 0000006D EF                      	out dx, ax
    83                                  
    84                                  	; Store the segment pattern for "D".
    85 0000006E B85E00                  	mov ax, 0005Eh
    86 00000071 EF                      	out dx, ax
    87                                  stop:
    88 00000072 C706[9401]0100              mov word [status], 1
    89 00000078 CD02                    	int 2
    90                                  
    91                                  trace_full:
    92 0000007A C706[9401]0200              mov word [status], 2
    93 00000080 EBFE                        jmp $
    94                                  
    95                                  overflow:
    96 00000082 C706[9401]0300              mov word [status], 3
    97 00000088 EBFE                        jmp $
    98                                  
    99                                  delay:
   100 0000008A 51                          push cx
   101 0000008B B93000                  	mov cx, 48
   102                                  .wait:
   103 0000008E E2FE                    	loop .wait
   104 00000090 59                          pop cx
   105 00000091 C3                      	ret
   106                                  
   107                                  ; Data lives after the endless loops, so execution never falls into it.
   108                                  ; test dw
   109                                  trace:
   110 00000092 0000<rep 80h>               times 128 dw 0
   111                                  trace_end:
   112                                  
   113                                  steps:
   114 00000192 0000                        dw 0
   115                                  
   116                                  status:
   117 00000194 0000                        dw 0
