     1                                  org 0100h
     2                                  bits 16
     3                                  
     4                                  start:
     5                                  	; Select Display RAM address 0 and enable auto-increment.
     6 00000000 BAEAFF                  	mov dx, 0FFEAH
     7 00000003 B090                    	mov al, 90H
     8 00000005 EE                      	out dx, al
